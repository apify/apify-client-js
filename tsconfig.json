{
    "extends": "@apify/tsconfig",
    "compilerOptions": {
        "allowJs": true,
        "lib": ["ES2024", "DOM"],
        "target": "ES2024",
        "outDir": "dist",
        "rootDir": "src",
        "skipLibCheck": true,
        "declarationMap": false,
        "sourceMap": false
    },
    "include": ["./src/**/*"]
}
