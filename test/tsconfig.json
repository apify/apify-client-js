{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "rootDir": "../",
        "noEmit": true,
        "allowJs": true,
        // test/spec_transform.test.ts imports the generator's helpers by their real `.mts` path.
        "allowImportingTsExtensions": true,
        "paths": {
            "apify-client": ["../src"]
        }
    },
    "include": [".", "../src/**/*", "../scripts/**/*"]
}
